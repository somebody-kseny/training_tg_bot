# --- proxy (Cloud Function) ---
WEBHOOK_SECRET=
CORE_FUNCTION_URL=https://functions.yandexcloud.net/<core-function-id>
CORE_INVOKE_API_KEY=

# --- core (Cloud Function / локальный long polling) ---
BOT_TOKEN=
# Bot API через внешний прокси
TELEGRAM_API_BASE=

# Yandex Cloud:
YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
YDB_DATABASE=/ru-central1/<cloud-id>/<database-id>
YDB_SERVICE_ACCOUNT_KEY_FILE_CREDENTIALS=/path/to/sa-key.json
