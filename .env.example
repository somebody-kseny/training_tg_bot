# --- core (VPS webhook) ---
BOT_TOKEN=
WEBHOOK_SECRET=
WEBHOOK_URL=https://<server_domen>/foo
WEBHOOK_PATH=/foo
LISTEN_PORT=8000

# Bot API: напрямую или через ваш HTTPS-прокси
TELEGRAM_API_BASE=https://api.telegram.org

# Yandex YDB (сервер):
YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
YDB_DATABASE=/ru-central1/<cloud-id>/<database-id>
YDB_SERVICE_ACCOUNT_KEY_FILE_CREDENTIALS=/opt/trens-bot/authorized_key.json
